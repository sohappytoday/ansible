#jinja2: trim_blocks: True, lstrip_blocks: True
# HAProxy — Kubernetes API server 로드밸런싱
# 참고: kubeadm ha-considerations.md
global
    log /dev/log local0
    log /dev/log local1 notice
    daemon

defaults
    mode                tcp
    log                 global
    option              tcplog
    option              dontlognull
    timeout connect     5s
    timeout client      30s
    timeout server      30s
    retries             3

frontend apiserver
    bind *:{{ install_kubernetes_apiserver_port }}
    mode tcp
    option tcplog
    default_backend apiserverbackend

backend apiserverbackend
    option httpchk
    http-check connect ssl
    http-check send meth GET uri /healthz
    http-check expect status 200
    mode tcp
    balance roundrobin
    {% for host in groups['control_plane'] %}
    server {{ host }} {{ hostvars[host].ansible_host | default(hostvars[host].ansible_default_ipv4.address) }}:6443 check verify none
    {% endfor %}
